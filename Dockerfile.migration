FROM node:20-alpine

RUN apk add --no-cache postgresql-client sqlite

WORKDIR /app/server

COPY server/package.json server/package-lock.json ./
RUN npm ci

COPY server/prisma ./prisma
COPY scripts/migrate-sqlite-to-postgres.sh /usr/local/bin/migrate-sqlite-to-postgres
COPY scripts/verify-sqlite-postgres-export.mjs /usr/local/bin/verify-sqlite-postgres-export.mjs

RUN chmod 0555 /usr/local/bin/migrate-sqlite-to-postgres

ENTRYPOINT ["/usr/local/bin/migrate-sqlite-to-postgres"]
