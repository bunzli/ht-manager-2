# Keep .env in the main Git checkout; npm run dev shares it with all worktrees.
# npm run dev assigns a free API port and configures the client proxy itself.
# PORT is only used when starting the server directly or with Docker.
PORT=3001
# Relative SQLite paths resolve from server/prisma in the main checkout.
DATABASE_URL="file:./prisma/dev.db"

# Production is PostgreSQL only. Set DATABASE_URL in Dockge's secret/environment
# store; never add its value to this file or commit it.

# CHPP OAuth credentials (server-only)
CHPP_CONSUMER_KEY="your_consumer_key"
CHPP_CONSUMER_SECRET="your_consumer_secret"
CHPP_ACCESS_TOKEN="your_access_token"
CHPP_ACCESS_TOKEN_SECRET="your_access_token_secret"
CHPP_TEAM_ID="your_team_id"

# Optional proxy for a directly started Vite server (npm run dev sets it itself).
# VITE_PROXY_TARGET="http://127.0.0.1:3001"
